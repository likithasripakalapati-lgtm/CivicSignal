NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=civicsignal
JWT_SECRET=<replace-with-a-random-secret-at-least-32-characters>
JWT_ISSUER=civicsignal-api
JWT_AUDIENCE=civicsignal-client
JWT_ACCESS_TOKEN_TTL_SECONDS=900
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_PDF_PAGES=100
UPLOAD_MAX_IMAGE_PIXELS=40000000
GRIDFS_BUCKET_NAME=civicDocuments
# Optional; defaults to the operating system temp directory under civicsignal-uploads.
# UPLOAD_TEMP_DIR=
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_LEASE_MS=300000
PROCESSING_POLL_INTERVAL_MS=1000
OCR_MAX_RENDER_PIXELS=12000000
# Optional; defaults to server/tessdata.
# OCR_TESSDATA_DIR=
